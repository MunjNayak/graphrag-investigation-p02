INGEST_POLL_SECONDS=2
INGEST_TIMEOUT_SECONDS=300
INGEST_PARSE_TIMEOUT_SECONDS=900
ENABLE_INGESTION=true
INGEST_PROFILE_DEFAULT=balanced_fast
RAG_LLM_TIMEOUT_SECONDS=1000


# LLM Provider
LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#LLM_PROVIDER_API_KEY=
LLM_PROVIDER_SITE_URL=http://localhost:5173
LLM_PROVIDER_APP_NAME=project GraphRAG
#RAG_LLM_MODEL=openai/gpt-5.4-mini
RAG_LLM_MODEL=google/gemma-4-31b-it:free
RAG_VLM_MODEL=google/gemma-4-31b-it:free
RAG_LLM_MAX_ASYNC=1

# Embedding Provider (leave unset to use same provider as LLM)
EMBEDDING_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#EMBEDDING_PROVIDER_API_KEY=
RAG_EMBEDDING_MODEL=baai/bge-m3
RAG_EMBEDDING_DIM_HINT=1024
RAG_EMBEDDING_MAX_ASYNC=8
RAG_MAX_PARALLEL_INSERT=1
RAG_MAX_PARALLEL_INSERT_BALANCED=2
RAG_MAX_PARALLEL_INSERT_FULL=2

RAG_PARSER=mineru
RAG_PARSE_METHOD=auto
RAG_PARSER_DEVICE=cpu
RAG_PARSER_BACKEND=pipeline
PDF_PROBE_MIN_CHARS_PER_PAGE=180
RAG_ENABLE_TABLE_BALANCED_MAX_PAGES=12
RAG_ENABLE_FORMULA_BALANCED=false
IMAGE_VLM_MIN_OCR_CHARS=120
RAG_ENABLE_VLM=true
RAG_ENABLE_VLM_IMAGE_ANALYSIS=true
RAG_ENABLE_VLM_VISIBLE_TEXT_EXTRACTION=true
RAG_ENABLE_PREINSERT_SUMMARY=true
RAG_PREINSERT_SUMMARY_MAX_INPUT_CHARS=24000
RAG_PREINSERT_SUMMARY_MAX_TOKENS=400
RAG_BALANCED_FORCE_VLM_IMAGE_CAPTION=true
RAG_VLM_PARALLEL_CAPTIONS_BALANCED=6
RAG_VLM_PARALLEL_CAPTIONS_FULL=4
RAG_ENABLE_IMAGE_PROCESSING=true
RAG_ENABLE_TABLE_PROCESSING=true
RAG_ENABLE_EQUATION_PROCESSING=false
RAG_COSINE_THRESHOLD=0.55
RAG_NAIVE_COSINE_THRESHOLD=0.45
RAG_LLM_MAX_TOKENS=4096
RAG_EVIDENCE_NORMALIZATION_MAX_TOKENS=2048
RAG_TOP_K=10
RAG_CHUNK_TOP_K=10

RERANK_PROVIDER_BASE_URL=https://openrouter.ai/api/v1/rerank
#RERANK_PROVIDER_API_KEY=
RAG_RERANK_MODEL=cohere/rerank-4-fast
RAG_RERANK_ENABLED=true

# Chunking
RAG_CHUNK_TOKEN_SIZE=500
RAG_CHUNK_OVERLAP_TOKEN_SIZE=50

# Entity resolution
RAG_RESOLUTION_SIMILARITY_THRESHOLD=0.6
RAG_RESOLUTION_MIN_REFERENCE_RATIO=0.03
RAG_RESOLUTION_AUTO_TRIGGER=true
RAG_RESOLUTION_ENABLE_INCREMENTAL=true


# Eval
EVALUATOR_TIMEOUT=300
EVALUATOR_MAX_TOKENS=8192
